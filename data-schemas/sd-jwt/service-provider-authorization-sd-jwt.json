{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-build.example.com/schemas/authorizedserviceprovider/2.0/sd-jwt-vc-schema.json",
  "title": "AuthorizedServiceProvider SD-JWT VC Schema",
  "description": "Schema for the Authorized Service Provider Attestation (one attestation per mandate) encoded as SD-JWT VC, based on the WE BUILD Attestation Rulebook for attestations of type Authorized Service Provider, version 2.0 (Use Case SC5). The schema applies to the claim set after selective disclosures are processed.",
  "type": "object",
  "required": [
    "vct",
    "iss",
    "iat",
    "exp",
    "attestation_legal_category",
    "status",
    "cnf",
    "authorizing_company",
    "authorized_service_provider",
    "mandate",
    "authorization_valid_from"
  ],
  "$defs": {
    "network_identifier": {
      "type": "object",
      "description": "Identifier of a party in the network or infrastructure used to deliver the mandated service, qualified by its scheme (code list 4.4).",
      "additionalProperties": false,
      "required": [
        "scheme",
        "id"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "enum": [
            "peppol-participant",
            "peppol-ap"
          ],
          "description": "Identifier scheme: 'peppol-participant' for a Peppol participant identifier as ICD:identifier, 'peppol-ap' for a Peppol Access Point seat ID."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The identifier value in the given scheme."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "peppol-participant"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^[0-9]{4}:.+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "peppol-ap"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^P[A-Z]{2}[0-9]{6}$"
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "vct": {
      "type": "string",
      "const": "eu.we-build:authorizedserviceprovider:2",
      "description": "Verifiable Credential Type. NOT selectively disclosable."
    },
    "iss": {
      "type": "string",
      "format": "uri",
      "description": "Issuer identifier (the authorising company's issuing system / EBW). NOT selectively disclosable."
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "description": "Issued At. NOT selectively disclosable."
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "description": "Expiration Time. NOT selectively disclosable."
    },
    "nbf": {
      "type": "integer",
      "minimum": 0,
      "description": "Not Before. Optional. NOT selectively disclosable."
    },
    "sub": {
      "type": "string",
      "description": "Subject identifier (the authorised Service Provider). Optional. NOT selectively disclosable."
    },
    "attestation_legal_category": {
      "type": "string",
      "enum": [
        "EAA"
      ],
      "description": "Legal category of this attestation. NOT selectively disclosable."
    },
    "schema_version": {
      "type": "string",
      "description": "Version of the schema used. Optional.",
      "examples": [
        "2.0"
      ]
    },
    "trust_anchor_url": {
      "type": "string",
      "format": "uri",
      "description": "Trust anchor location (chapter 10 of the Rulebook). Optional."
    },
    "cryptographically_bound_to": {
      "type": "string",
      "const": "uri:eu.ebw.oid.1",
      "description": "vct of the Service Provider's EBWOID. RECOMMENDED. NOT selectively disclosable."
    },
    "authorizing_company": {
      "type": "object",
      "description": "The company (mandator) issuing the mandate. Mandatory. MAY be selectively disclosable.",
      "additionalProperties": false,
      "required": [
        "legal_name",
        "legal_id"
      ],
      "properties": {
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "description": "Registered legal name of the authorising company."
        },
        "legal_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique legal-person identifier (EUID) of the authorising company, sourced from its EBWOID."
        },
        "network_identifier": {
          "$ref": "#/$defs/network_identifier"
        }
      }
    },
    "authorized_service_provider": {
      "type": "object",
      "description": "The Service Provider (mandatary) receiving the mandate; the holder. Mandatory. MAY be selectively disclosable.",
      "additionalProperties": false,
      "required": [
        "legal_name",
        "legal_id"
      ],
      "properties": {
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "description": "Registered legal name of the Service Provider."
        },
        "legal_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique legal-person identifier (EUID) of the Service Provider, sourced from its EBWOID."
        },
        "network_identifier": {
          "$ref": "#/$defs/network_identifier"
        }
      }
    },
    "mandate": {
      "type": "object",
      "description": "The single mandate expressed by this attestation: the service, the operations within it, and the EU Member State whose regime the service fulfils. Mandatory. MAY be selectively disclosable.",
      "additionalProperties": false,
      "required": [
        "service",
        "operations",
        "jurisdiction"
      ],
      "properties": {
        "service": {
          "type": "string",
          "enum": [
            "einvoicing",
            "tax_reporting"
          ],
          "description": "Type of service mandated (code list 4.4)."
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "send",
              "receive",
              "report"
            ]
          },
          "description": "Operations the Service Provider may perform within the service; allowed values depend on the service (IR-ASP-02)."
        },
        "jurisdiction": {
          "type": "string",
          "enum": [
            "AT",
            "BE",
            "BG",
            "CY",
            "CZ",
            "DE",
            "DK",
            "EE",
            "ES",
            "FI",
            "FR",
            "GR",
            "HR",
            "HU",
            "IE",
            "IT",
            "LT",
            "LU",
            "LV",
            "MT",
            "NL",
            "PL",
            "PT",
            "RO",
            "SE",
            "SI",
            "SK"
          ],
          "description": "ISO 3166-1 alpha-2 code of the EU Member State whose regime the service fulfils (Greece is GR)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "service": {
                "const": "einvoicing"
              }
            }
          },
          "then": {
            "properties": {
              "operations": {
                "items": {
                  "enum": [
                    "send",
                    "receive"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "service": {
                "const": "tax_reporting"
              }
            }
          },
          "then": {
            "properties": {
              "operations": {
                "items": {
                  "enum": [
                    "report"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "authorization_valid_from": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date from which the mandate is valid. Mandatory. MAY be selectively disclosable."
    },
    "authorization_valid_until": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date until which the mandate is valid. Optional. MAY be selectively disclosable."
    },
    "authorization_reference": {
      "type": "string",
      "description": "Company-internal reference for the service agreement. Optional. MUST be selectively disclosable."
    },
    "status": {
      "type": "object",
      "description": "Status claim per the IETF Token Status List. NOT selectively disclosable.",
      "additionalProperties": false,
      "required": [
        "status_list"
      ],
      "properties": {
        "status_list": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idx",
            "uri"
          ],
          "properties": {
            "idx": {
              "type": "integer",
              "minimum": 0
            },
            "uri": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "cnf": {
      "type": "object",
      "description": "Holder key binding. NOT selectively disclosable.",
      "additionalProperties": false,
      "required": [
        "jwk"
      ],
      "properties": {
        "jwk": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kty": {
              "type": "string"
            },
            "crv": {
              "type": "string"
            },
            "x": {
              "type": "string"
            },
            "y": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "IR-ASP-03: an eInvoicing mandate requires the Peppol identifiers of both parties.",
      "if": {
        "properties": {
          "mandate": {
            "properties": {
              "service": {
                "const": "einvoicing"
              }
            }
          }
        },
        "required": [
          "mandate"
        ]
      },
      "then": {
        "properties": {
          "authorizing_company": {
            "required": [
              "network_identifier"
            ],
            "properties": {
              "network_identifier": {
                "properties": {
                  "scheme": {
                    "const": "peppol-participant"
                  }
                }
              }
            }
          },
          "authorized_service_provider": {
            "required": [
              "network_identifier"
            ],
            "properties": {
              "network_identifier": {
                "properties": {
                  "scheme": {
                    "const": "peppol-ap"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
