{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/mc-sd-jwt.json",
  "title": "Micro-credential Attestation – SD-JWT VC payload",
  "description": "Schema for the SD-JWT VC payload of a Micro-credential Attestation. Derived only from mandatory attributes (Rulebook 3.2) and mandatory metadata (Rulebook 4.1).",
  "type": "object",
  "version": "1.0.0",
  "additionalProperties": true,

  "properties": {
    "vct": {
      "type": "string",
      "const": "https://webuildconsortium.eu/credentials/microcredential/1.0",
      "description": "Verifiable Credential Type identifying the Micro-credential Attestation.",
      "examples": [
        "https://webuildconsortium.eu/credentials/microcredential/1.0"
      ]
    },

    "iss": {
      "type": "string",
      "description": "Identifier of the issuer of the credential.",
      "examples": [
        "https://issuer.example-university.edu"
      ]
    },

    "iat": {
      "type": "integer",
      "description": "Time at which the credential was issued (epoch seconds).",
      "examples": [
        1781740800
      ]
    },

    "cnf": {
      "type": "object",
      "description": "Holder binding confirmation claim.",
      "additionalProperties": true,
      "properties": {
        "jwk": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kty": {
              "type": "string",
              "examples": ["EC", "RSA"]
            },
            "crv": {
              "type": "string",
              "examples": ["P-256"]
            },
            "x": {
              "type": "string"
            },
            "y": {
              "type": "string"
            },
            "e": {
              "type": "string"
            },
            "n": {
              "type": "string"
            },
            "kid": {
              "type": "string"
            },
            "alg": {
              "type": "string",
              "examples": ["ES256", "RS256"]
            }
          },
          "required": [
            "kty"
          ]
        }
      },
      "required": [
        "jwk"
      ]
    },

    "attestation_legal_category": {
      "type": "string",
      "const": "non-qualified-EAA",
      "description": "Legal category of the attestation."
    },

    "identifier": {
      "type": "string",
      "description": "Unique identifier of the micro-credential instance.",
      "examples": [
        "MC-2026-0007421"
      ]
    },

    "title": {
      "type": "string",
      "description": "Title of the micro-credential.",
      "examples": [
        "Introduction to Applied Data Ethics"
      ]
    },

    "givenName": {
      "type": "string",
      "description": "Learner given name.",
      "examples": [
        "Elena"
      ]
    },

    "familyName": {
      "type": "string",
      "description": "Learner family name.",
      "examples": [
        "Kowalska"
      ]
    },

    "issuerCountry": {
      "type": "string",
      "description": "Country or region of the organisation that sealed or issued the credential.",
      "examples": [
        "http://publications.europa.eu/resource/authority/country/SWE"
      ]
    },

    "awardingBody": {
      "type": "object",
      "description": "Formal education provider that awarded the micro-credential.",
      "additionalProperties": true,
      "properties": {
        "legalName": {
          "type": "string"
        },
        "legalIdentifier": {
          "type": "string"
        }
      },
      "required": [
        "legalName"
      ],
      "examples": [
        {
          "legalName": "Linköping University",
          "legalIdentifier": "999852236"
        }
      ]
    },

    "issuanceDate": {
      "type": "string",
      "format": "date",
      "description": "Date on which the credential was sealed and issued.",
      "examples": [
        "2026-06-15"
      ]
    },

    "learningOutcomes": {
      "type": "array",
      "description": "Learning outcomes acquired by the learner.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "description"
        ]
      },
      "examples": [
        [
          {
            "title": "The title of the learning outcome",
            "description": "The actual learning outcome"
          }
        ]
      ]
    },

    "ECTS": {
      "type": "number",
      "minimum": 0,
      "description": "ECTS credits awarded.",
      "examples": [
        3.0
      ]
    },

    "volumeOfLearning": {
      "type": "string",
      "description": "Volume of learning expressed as ISO 8601 duration.",
      "examples": [
        "PT8H"
      ]
    },

    "typeOfAssessment": {
      "type": "array",
      "description": "Assessment types used to validate the learning outcomes.",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "http://data.europa.eu/snb/assessment/6a4db9f11d"
        ]
      ]
    },

    "formOfParticipation": {
      "type": "string",
      "description": "Form of participation in the learning activity.",
      "examples": [
        "http://data.europa.eu/snb/learning-assessment/920fbb3cbe"
      ]
    },

    "qualityAssurance": {
      "type": "string",
      "description": "Type of quality assurance underpinning the micro-credential.",
      "examples": [
        "institutional-accreditation"
      ]
    }
  },

  "required": [
    "vct",
    "iss",
    "iat",
    "cnf",
    "attestation_legal_category",
    "identifier",
    "title",
    "givenName",
    "familyName",
    "issuerCountry",
    "awardingBody",
    "issuanceDate",
    "learningOutcomes",
    "typeOfAssessment",
    "formOfParticipation",
    "qualityAssurance"
  ],

  "oneOf": [
    {
      "required": [
        "ECTS"
      ]
    },
    {
      "required": [
        "volumeOfLearning"
      ]
    }
  ]
}
