{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/verified-skill-sd-jwt-v0.3.json",
  "title": "Verified Skill Attestation — SD-JWT VC payload (v0.3)",
  "description": "Schema for the reconstructed full issued Verified Skill SD-JWT VC payload. MC v1.0 compatible claim structures where semantically equivalent; validation-status-specific conditional obligations from VS Rulebook v0.3. Does not verify signatures, SD disclosures, trust or underlying assessments. Credential-type URI is provisional.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "vct": {
      "type": "string",
      "const": "https://webuildconsortium.eu/credentials/verified-skill/0.3",
      "description": "Provisional credential-type URI; must be approved and published before production."
    },
    "iss": {
      "type": "string",
      "minLength": 1,
      "description": "Credential issuer."
    },
    "iat": {
      "type": "integer",
      "description": "Issued at, NumericDate epoch seconds."
    },
    "cnf": {
      "type": "object",
      "description": "Holder public key confirmation. Required by the deployed holder-binding profile where applicable.",
      "additionalProperties": true,
      "properties": {
        "jwk": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kty": {
              "type": "string"
            },
            "crv": {
              "type": "string"
            },
            "x": {
              "type": "string"
            },
            "y": {
              "type": "string"
            },
            "e": {
              "type": "string"
            },
            "n": {
              "type": "string"
            },
            "kid": {
              "type": "string"
            },
            "alg": {
              "type": "string"
            }
          },
          "required": [
            "kty"
          ]
        }
      },
      "required": [
        "jwk"
      ]
    },
    "category": {
      "type": "string",
      "const": "eaa:eu:non-qualified",
      "description": "Non-qualified EAA category in selected EUDI Rulebook template."
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier of the Verified Skill attestation."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Credential title."
    },
    "givenName": {
      "type": "string",
      "minLength": 1,
      "description": "Holder given name."
    },
    "familyName": {
      "type": "string",
      "minLength": 1,
      "description": "Holder family name."
    },
    "issuerCountry": {
      "type": "string",
      "minLength": 1,
      "description": "Issuer country URI, MC-compatible string representation."
    },
    "awardingBody": {
      "type": "object",
      "description": "Awarding organisation, identical object structure to the published MC v1.0 schema; required for validated status.",
      "additionalProperties": true,
      "properties": {
        "legalName": {
          "type": "string"
        },
        "legalIdentifier": {
          "type": "string"
        }
      },
      "required": [
        "legalName"
      ]
    },
    "issuanceDate": {
      "type": "string",
      "format": "date"
    },
    "learningOutcomes": {
      "type": "array",
      "minItems": 1,
      "description": "Identical array/object structure to published MC schema.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "description"
        ]
      }
    },
    "volumeOfLearning": {
      "type": "string",
      "pattern": "^P(?=.+)(?:(?:[1-9]\\d*)D)?(?:T(?:(?:[1-9]\\d*)H)?(?:(?:[1-9]\\d*)M)?(?:(?:[1-9]\\d*)S)?)?$",
      "description": "Optional positive ISO 8601 day/time duration. ECTS is not used by VS.",
      "examples": [
        "PT80H",
        "P2DT3H"
      ]
    },
    "typeOfAssessment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "MC-compatible array of assessment-type vocabulary identifiers."
    },
    "formOfParticipation": {
      "type": "string",
      "description": "MC-compatible learning-activity participation vocabulary identifier."
    },
    "qualityAssurance": {
      "type": "string",
      "enum": [
        "institutional-accreditation",
        "programme-accreditation",
        "national-quality-agency",
        "sectoral-quality-assurance",
        "documented-internal-qa",
        "independent-external-qa"
      ],
      "description": "MC-compatible string, with two VS-specific approved draft values."
    },
    "validationStatus": {
      "type": "string",
      "enum": [
        "identified",
        "documented",
        "validated"
      ]
    },
    "skillProficiencyLevel": {
      "type": "string",
      "enum": [
        "novice",
        "advanced-beginner",
        "competent",
        "proficient",
        "expert"
      ]
    },
    "assessmentStandard": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title"
      ],
      "description": "VS assessment specification mapped to ELM LearningAssessmentSpecification; title mandatory; external reference or criteria available under issuing policy.",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "reference": {
          "type": "string",
          "format": "uri"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "grade": {
      "type": "string",
      "minLength": 1,
      "description": "MC-compatible assessment grade, e.g. Pass."
    },
    "gradingScheme": {
      "type": "string",
      "minLength": 1,
      "description": "MC-compatible string for grading scheme; Pass/Fail is VS default."
    },
    "assessmentDate": {
      "type": "string",
      "format": "date"
    },
    "assessor": {
      "description": "MC-style organisation or VS individual assessor.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "legalName"
          ],
          "properties": {
            "legalName": {
              "type": "string",
              "minLength": 1
            },
            "legalIdentifier": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "fullName"
          ],
          "properties": {
            "fullName": {
              "type": "string",
              "minLength": 1
            },
            "personIdentifier": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "validatingBody": {
      "type": "object",
      "description": "Entity responsible for confirmation of formal validation, MC organisation object structure.",
      "additionalProperties": true,
      "properties": {
        "legalName": {
          "type": "string"
        },
        "legalIdentifier": {
          "type": "string"
        }
      },
      "required": [
        "legalName"
      ]
    },
    "assessmentIndependence": {
      "type": "string",
      "enum": [
        "internal-assessment",
        "independent-third-party"
      ]
    },
    "supportingEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        },
        "anyOf": [
          {
            "required": [
              "description"
            ]
          },
          {
            "required": [
              "reference"
            ]
          }
        ],
        "additionalProperties": true
      }
    },
    "validationProcess": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "uniqueItems": false,
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "identification",
                  "documentation",
                  "assessment",
                  "certification"
                ]
              },
              "completionDate": {
                "type": "string",
                "format": "date"
              },
              "responsibleBody": {
                "type": "object",
                "description": "Awarding organisation, identical object structure to the published MC v1.0 schema; required for validated status.",
                "additionalProperties": true,
                "properties": {
                  "legalName": {
                    "type": "string"
                  },
                  "legalIdentifier": {
                    "type": "string"
                  }
                },
                "required": [
                  "legalName"
                ]
              },
              "evidenceReference": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "escoReference": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "recognitionReference": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "minProperties": 1
      }
    },
    "accreditation": {
      "type": "object",
      "additionalProperties": true,
      "minProperties": 1
    },
    "reviewDate": {
      "type": "string",
      "format": "date"
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date"
    },
    "placeOfBirth": {
      "type": "string"
    },
    "citizenshipCountry": {
      "type": "string"
    },
    "nationalID": {
      "type": "string"
    },
    "registeredAddress": {
      "type": "string"
    },
    "mail": {
      "type": "string"
    },
    "exp": {
      "type": "integer"
    },
    "nbf": {
      "type": "integer"
    },
    "jti": {
      "type": "string"
    },
    "status": {
      "type": "object",
      "additionalProperties": true
    },
    "trust_anchor": {
      "type": "string"
    },
    "cryptographically_bound_to": {
      "type": "string"
    }
  },
  "required": [
    "vct",
    "iss",
    "iat",
    "category",
    "identifier",
    "title",
    "givenName",
    "familyName",
    "issuerCountry",
    "issuanceDate",
    "learningOutcomes",
    "validationStatus"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "validationStatus": {
            "const": "validated"
          }
        },
        "required": [
          "validationStatus"
        ]
      },
      "then": {
        "required": [
          "skillProficiencyLevel",
          "typeOfAssessment",
          "assessmentStandard",
          "grade",
          "gradingScheme",
          "awardingBody",
          "assessmentDate",
          "assessor",
          "validatingBody",
          "assessmentIndependence",
          "qualityAssurance"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "validationStatus": {
            "const": "identified"
          }
        },
        "required": [
          "validationStatus"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "grade"
              ]
            },
            {
              "required": [
                "validatingBody"
              ]
            },
            {
              "required": [
                "assessmentIndependence"
              ]
            },
            {
              "required": [
                "gradingScheme"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "grade"
        ]
      },
      "then": {
        "required": [
          "gradingScheme"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "validationStatus": {
            "const": "validated"
          },
          "gradingScheme": {
            "const": "Pass/Fail"
          }
        },
        "required": [
          "validationStatus",
          "gradingScheme"
        ]
      },
      "then": {
        "properties": {
          "grade": {
            "const": "Pass"
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "attestation_legal_category"
        ]
      }
    },
    {
      "not": {
        "required": [
          "ECTS"
        ]
      }
    }
  ],
  "version": "0.3.0"
}
