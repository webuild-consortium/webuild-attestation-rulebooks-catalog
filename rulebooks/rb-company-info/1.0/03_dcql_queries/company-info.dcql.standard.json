        {"path": ["legal_entity","legal_person","legal_form_type"]},
        {"path": ["legal_entity","identifier","euid"]},
        {"path": ["legal_entity","identifier","lei"]},
        {"path": ["legal_entity","identifier","tax"]},
        {"path": ["legal_entity","identifier","gln"]},
        {"path": ["legal_entity","identifier","duns"]},
        {"path": ["legal_entity","identifier","eori"]},
        {"path": ["legal_entity","identifier","bpnl"]},
        {"path": ["legal_entity","identifier","siren"]},
        {"path": ["trade_alias"]},
        {"path": ["previous_legal_name"]},
        {"path": ["number_of_employees"]},
        {"path": ["financial_statements", "taxonomy"]},
        {"path": ["financial_statements", "facts", "id"]},
        {"path": ["financial_statements", "facts", "concept"]},
        {"path": ["financial_statements", "facts", "value"]},
        {"path": ["financial_statements", "facts", "unit"]},
        {"path": ["financial_statements", "facts", "period_start"]},
        {"path": ["financial_statements", "facts", "period_end"]}
