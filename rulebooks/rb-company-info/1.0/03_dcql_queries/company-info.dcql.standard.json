        {"claim": "financial_statements", "required": false},
        {"claim": "previous_legal_name", "required": false},
        {"claim": "legal_entity.identifier.tax", "required": false},
        {"claim": "legal_entity.identifier.lei", "required": false},
        {"claim": "legal_entity.identifier.gln", "required": false},
        {"claim": "legal_entity.identifier.duns", "required": false},
        {"claim": "legal_entity.identifier.eori", "required": false},
        {"claim": "legal_entity.identifier.bpnl", "required": false},
        {"claim": "legal_entity.identifier.siren", "required": false}
      ]
    }
  ]
}
